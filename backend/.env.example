# --- Required: OpenAI-compatible client config ---
# Works with a real OpenAI key, or with an OpenAI-compatible multi-provider
# gateway (e.g. a router that exposes Claude/Gemini/etc behind one endpoint).
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Optional: per-role model overrides ---
# Point these at a DIFFERENT provider/model string (via a multi-provider
# gateway on OPENAI_BASE_URL) to demonstrate literal cross-provider routing
# and fallback, exactly as described in the job posting. If left blank,
# OPENAI_MODEL_NAME is reused for every role, and the demo still works --
# it just won't be hitting a second vendor.
GUARDRAIL_MODEL_NAME=
FALLBACK_MODEL_NAME=

# --- Optional: shared passcode gate for a public demo deployment ---
# Leave blank for local development (no auth). Set this before deploying
# publicly so API costs can't be run up by strangers.
DEMO_ACCESS_CODE=

# --- Storage ---
DATABASE_URL=sqlite:///./guardedcontext.db
